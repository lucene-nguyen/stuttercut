# Copy to .env and fill in. The LLM review runs locally by default (Ollama); with the anthropic
# provider only transcript text is sent. Key only needed for STUTTERCUT_LLM_PROVIDER=anthropic.
LLM_API_KEY=
# Folder with clips/, audacity/ and index.csv (outside the repo); used by eval scripts.
STUTTERCUT_DATA_DIR=

# --- App settings (all optional; defaults in backend/stuttercut/config.py) ---
# Data root for stuttercut.db, jobs/ and logs/. Empty = per-OS folder via platformdirs.
STUTTERCUT_HOME=
# auto = cuda -> mps -> cpu, or force one of cuda | mps | cpu
STUTTERCUT_DEVICE=auto
# CrisperWhisper 2.0 size, and the smaller one used when free RAM is low (ADR 0002)
STUTTERCUT_ASR_MODEL_SIZE=large
STUTTERCUT_ASR_FALLBACK_SIZE=turbo
# transformers (CPU/CUDA/MPS, two passes) or ct2 (CPU/CUDA only, one dual pass)
STUTTERCUT_ASR_BACKEND=transformers
# verbatim (default, one pass) or dual (+ intended transcript; ~2x transcribe time on transformers)
STUTTERCUT_ASR_PASSES=verbatim
STUTTERCUT_ASR_LANGUAGE=vi
# RAM pre-flight in GB: below LARGE use the fallback size, below ANY fail the job
STUTTERCUT_ASR_MIN_FREE_GB_LARGE=6
STUTTERCUT_ASR_MIN_FREE_GB_ANY=3
# torch CPU threads (0 = library default)
STUTTERCUT_ASR_THREADS=0
STUTTERCUT_MAX_DURATION_S=180
STUTTERCUT_FFMPEG_THREADS=2
STUTTERCUT_WORKER_NICE=10
STUTTERCUT_LOG_LEVEL=INFO
STUTTERCUT_LOG_MAX_BYTES=5242880
STUTTERCUT_LOG_BACKUP_COUNT=3

# --- Cut detection (LEARNING-207; defaults in RulesConfig, backend/stuttercut/config.py) ---
# Comma-separated, matched after normalising (case, punctuation, brackets: "[UH]" == "uh").
STUTTERCUT_FILLER_TOKENS=ờ,ơ,ừm,ưm,ờm,ơm,hm,hmm,uh,um,à,ừ
# Fillers that are also real words: cut only with silence on both sides
STUTTERCUT_AMBIGUOUS_FILLERS=à,ừ
STUTTERCUT_AMBIGUOUS_ISOLATION_MS=200
# Pause = word gap above MIN; KEEP stays on each side; more VAD speech than VOICED_MAX = no pause
STUTTERCUT_PAUSE_MIN_MS=600
STUTTERCUT_PAUSE_KEEP_MS=150
STUTTERCUT_PAUSE_VOICED_MAX_MS=100
STUTTERCUT_REPEAT_MAX_N=3
# Vietnamese reduplications that are words, never repeats
STUTTERCUT_REPEAT_KEEP=từ từ,dần dần,lâu lâu,thường thường,ngày ngày,người người,nhà nhà
STUTTERCUT_RETAKE_WINDOW_S=4
STUTTERCUT_RETAKE_MIN_WORDS=2
# a retake needs a filler or this much silence right before the restart
STUTTERCUT_RETAKE_MIN_HESITATION_MS=300
# Speech the VAD hears but no word covers (+-margin), between MIN and MAX ms -> filler candidate
STUTTERCUT_VAD_MIN_MS=150
STUTTERCUT_VAD_MAX_MS=1200
STUTTERCUT_VAD_WORD_MARGIN_MS=80
# silero speech probability; 0.8 because 0.5 hears a noisy mic as speech (lesson 003)
STUTTERCUT_VAD_THRESHOLD=0.8
STUTTERCUT_MERGE_GAP_MS=50
STUTTERCUT_MIN_CUT_MS=30

# --- LLM review of cut candidates (LEARNING-208; docs/guides/local-llm.md) ---
# ollama (default): a local model, nothing leaves the machine; needs Ollama running and the
# model pulled. anthropic: Messages API with LLM_API_KEY; only transcript text is sent (ADR 0001).
STUTTERCUT_LLM_ENABLED=false
STUTTERCUT_LLM_PROVIDER=ollama
# Empty = qwen3:8b for ollama, claude-sonnet-5-5 for anthropic
STUTTERCUT_LLM_MODEL=
STUTTERCUT_OLLAMA_URL=http://127.0.0.1:11434
# ollama context window in tokens, and how long Ollama keeps the model loaded after a request
STUTTERCUT_LLM_NUM_CTX=8192
STUTTERCUT_LLM_KEEP_ALIVE=1m
# ollama only: free the ASR model before the review when free RAM (GB) is below this
STUTTERCUT_LLM_UNLOAD_ASR_BELOW_GB=8
# anthropic only: output_config.effort (low | medium | high)
STUTTERCUT_LLM_EFFORT=medium
STUTTERCUT_LLM_TIMEOUT_S=30
STUTTERCUT_LLM_MAX_TOKENS=8000
# Transcript chunks per request, and words shared between neighbouring chunks
STUTTERCUT_LLM_CHUNK_WORDS=300
STUTTERCUT_LLM_CHUNK_OVERLAP_WORDS=40
# final confidence = (1 - WEIGHT) * rule confidence + WEIGHT * LLM cut probability
STUTTERCUT_LLM_WEIGHT=0.6
# Review tier: final confidence >= this is "sure", below is "unsure"
STUTTERCUT_TIER_SURE_MIN=0.7
# anthropic: USD per million tokens, for the cost estimate in logs and the CLI (ollama = 0)
STUTTERCUT_LLM_PRICE_IN_PER_MTOK=2
STUTTERCUT_LLM_PRICE_OUT_PER_MTOK=10
# Optional: a file that replaces the built-in system prompt
STUTTERCUT_LLM_PROMPT_FILE=
